  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "hono": "^3.12.12",
    "typescript": "^5.9.3",
    "jiti": "^2.6.1",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "clipanion": "^4.0.0-rc.4",
    "esbuild": "^0.25.12",
    "esbuild-plugin-tsconfig-paths": "^1.0.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "latest",
    "@types/fs-extra": "^11.0.4",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.61.1"
  }
}
